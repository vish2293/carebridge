PORT=5000
NODE_ENV=development

# Database
MONGO_URL=mongodb://localhost:27017/carebridge
# Auth and encryption (use long random strings)
JWT_SECRETE_KEY=change-me
CRYPTO_SECRET_KEY=change-me

# App URLs
BASE_URL=http://localhost:5000
CURRENT_URL=http://localhost:5173

# Email (Gmail OAuth)
EMAIL_USER=
CONTACT_MAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=

# S3-compatible storage (file uploads)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_BASE_URL=

# Frontend and admin (Vite, only VITE_ vars are exposed to the browser)
VITE_APP_SERVICE_URL=http://localhost:5000
VITE_APP_S3_BASE_URL=
# Must match CRYPTO_SECRET_KEY above
VITE_APP_CRYPTO_SECRET_KEY=change-me

# Comma separated frontend/admin URLs allowed by CORS (e.g. https://app.example.com,https://admin.example.com)
CORS_ORIGINS=

# Secret Vercel Cron sends as a Bearer token to /cron/reminders (any long random string)
CRON_SECRET=
